# Copy this file to .env and fill in what you need. Every setting is optional.

# Admin PIN: unlocks Controls -> "Reset & load demo data" and "Reset database (empty)".
ADMIN_PIN=

# Demo data on start: 1 = load the samples into an empty database (default),
# reset = reload the samples on every start, 0 = never load them.
DEMO_AUTOLOAD=1

# Email intake (IMAP). Leave EMAIL_HOST empty to switch the inbox monitor off.
EMAIL_HOST=
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_PORT=993
EMAIL_MAILBOX=INBOX
EMAIL_SUBJECT_FILTER=
EMAIL_LOOKBACK_DAYS=30
POLL_SECONDS=60
EMAIL_AUTO_FETCH=1
