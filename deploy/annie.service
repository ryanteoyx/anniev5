[Unit]
Description=Annie (Streamlit)
After=network-online.target
Wants=network-online.target

[Service]
User=annie
WorkingDirectory=/opt/annie/app
ExecStart=/opt/annie/venv/bin/streamlit run app.py --server.headless true --server.address 127.0.0.1 --server.port 8501 --browser.gatherUsageStats false
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
